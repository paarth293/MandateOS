[TEMPLATE]
# ==============================================================================
# MandateOS Environment Configuration Template
#
# Copy this file to .env or .env.local and populate the values below.
# Required for the hackathon demo: DATABASE_URL, GATEWAY_MODE=mock, and an
# AGENT_KEY_PATH pointing at agent.key written by `npm run seed`.
# ==============================================================================

# 1. DATABASE (Neon Serverless PostgreSQL)
# Required: Connection string for Neon PostgreSQL (pooled HTTP driver)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/mandate_os?sslmode=require"

# 2. SESSION & AUTHENTICATION
# Required for production: 32+ character secret used to HMAC-sign session cookies.
# With it set, a leaked sessions table CANNOT forge a valid cookie.
# Leave blank in local dev — a safe deterministic fallback is used so demos work.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=""

# 3. PAYMENT GATEWAY (Razorpay)
# Mode: "mock" (offline deterministic test harness) or "live" (real Razorpay API)
GATEWAY_MODE="mock"

# Razorpay API Credentials (Required if GATEWAY_MODE="live")
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Webhook Secret for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# 4. ARTIFICIAL INTELLIGENCE (Google Gemini)
# Required: Gemini API key for explaining transaction failures in plain English.
# NOTE: the variable name must be GOOGLE_GENERATIVE_AI_API_KEY — that's what
# @ai-sdk/google's default provider reads internally (see src/server/ai.ts,
# which calls google("gemini-2.0-flash") with no explicit apiKey option).
# If this key is missing or wrong, Gemini calls fail silently and the
# deterministic fallback summary is used instead — the app still works,
# it just won't be genuinely AI-generated.
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 5. EVENT ORCHESTRATION (Inngest)
# Optional in local development (falls back to local Inngest Dev Server)
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"

# 6. APPLICATION & AGENT SIMULATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AGENT_API_URL="http://localhost:3000/api/agent/purchase"

# 7. AUDIT CHAIN EXPORT SIGNING (optional)
# The Ed25519 secret key used to sign `/api/export/chain` manifests.
# If neither is set, exports are emitted as explicitly UNSIGNED
# (signatureStatus: "UNSIGNED") instead of being signed with a fallback key.
# NEVER hardcode a real key in source or CI files.
AGENT_KEY_PATH="./agent.key"
AGENT_SECRET_KEY=""
